<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.edtech.monthly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /Users/keollim/Claude/Projects/edtech &amp;&amp; ./update_monthly.sh</string>
  </array>
  <!-- 매월 10일 새벽 3시. 시도교육청 계약공개가 월말 뒤 늦어도 10일 안에 올라온다. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key><integer>10</integer>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <!-- 그 시각에 잠들어 있었으면 깨어난 뒤에 한 번 돌린다 -->
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/keollim/Claude/Projects/edtech/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>/Users/keollim/Claude/Projects/edtech/logs/launchd.err.log</string>
</dict>
</plist>
